<Project>
  <PropertyGroup>
    <!--
      Default install path for Revit 2026's API assemblies. Change this
      if your Revit is installed somewhere else, or override per-build:
        dotnet build -p:RevitAPIPath="C:\Some\Other\Path"
    -->
    <RevitAPIPath Condition="'$(RevitAPIPath)' == ''">C:\Program Files\Autodesk\Revit 2026</RevitAPIPath>
  </PropertyGroup>
</Project>
