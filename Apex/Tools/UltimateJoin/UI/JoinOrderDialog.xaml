<Window x:Class="Apex.Tools.UltimateJoin.UI.JoinOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ultimate Join Elements"
        Width="480" Height="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border x:Name="Shell" CornerRadius="8" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== Custom title bar ===== -->
            <Border x:Name="TitleBar" Grid.Row="0" CornerRadius="8,8,0,0" Padding="14,8,8,8"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="TitleText" Text="&#9881;  Ultimate Join Elements"
                               FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="ThemeButton" Width="28" Height="24" Margin="0,0,6,0"
                            Click="ThemeButton_Click"/>
                    <Button Grid.Column="2" x:Name="CloseButton" Content="&#10005;" Width="28" Height="24"
                            Click="CancelButton_Click"/>
                </Grid>
            </Border>

            <!-- ===== Body ===== -->
            <Grid Grid.Row="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="SubtitleText" Text="Join Priority Order"
                                   FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="HelpButton" Content="?" Width="18" Height="18"
                                Margin="6,0,0,0" FontSize="11" FontWeight="Bold" Padding="0"
                                VerticalAlignment="Center" Cursor="Hand"
                                MouseEnter="HelpButton_MouseEnter" MouseLeave="HelpButton_MouseLeave"
                                Click="HelpButton_Click"/>
                    </Grid>
                </StackPanel>

                <Border Grid.Row="1" x:Name="ListBorder" CornerRadius="4" BorderThickness="1">
                    <ListBox x:Name="ItemsList" BorderThickness="0" Padding="4"
                             VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch"/>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button x:Name="ToggleAllButton" Content="Toggle All" Padding="12,6,12,6"
                            Margin="0,0,16,0" Click="ToggleAllButton_Click"/>
                    <Button x:Name="DefaultButton" Content="Reset to Default" Padding="12,6,12,6"
                            Margin="0,0,8,0" Click="DefaultButton_Click"/>
                    <Button x:Name="CancelButtonFooter" Content="Cancel" Padding="12,6,12,6"
                            Margin="0,0,8,0" Click="CancelButton_Click"/>
                    <Button x:Name="SaveButton" Content="Save Settings" Padding="14,6,14,6"
                            FontWeight="Bold" Click="SaveButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- ===== Help popup (hover on "?" or on the popup itself) ===== -->
            <Popup x:Name="HelpPopup" Placement="Bottom" StaysOpen="True"
                   AllowsTransparency="True" IsOpen="False">
                <Border x:Name="HelpBorder" CornerRadius="4" BorderThickness="1" Padding="10" MaxWidth="320"
                        MouseEnter="HelpButton_MouseEnter" MouseLeave="HelpButton_MouseLeave">
                    <TextBlock x:Name="HelpText" TextWrapping="Wrap" FontSize="11"
                        Text="Categories higher in the list cut through categories below them. Drag the &#8942;&#8942; handle on a row to reorder it. Uncheck a category to keep it always unjoined from everything else &#8212; its position then no longer matters."/>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
