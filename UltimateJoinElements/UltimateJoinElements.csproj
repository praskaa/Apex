<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Revit 2026 runs on .NET 8. Revit 2024/2025 use .NET Framework 4.8 —
    if you later multi-target, this TargetFramework line is the one to
    change/duplicate (see README "Adding another Revit version").
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>UltimateJoinElements</AssemblyName>
    <RootNamespace>UltimateJoinElements</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Revit hosts the process; add-ins must not copy Revit's own DLLs -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!--
    RevitAPIPath is defined in Directory.Build.props. Override per-machine
    with: dotnet build -p:RevitAPIPath="D:\Some\Other\Path"
  -->
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitAPIPath)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitAPIPath)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Ribbon icons, embedded into the assembly (pack URI: component/Icons/...) -->
    <Resource Include="Icons\join.small.png" />
    <Resource Include="Icons\join.large.png" />
    <Resource Include="Icons\configure.small.png" />
    <Resource Include="Icons\configure.large.png" />
  </ItemGroup>

  <!--
    After every build, drop the .addin manifest + dll into Revit's
    per-user Addins folder so F5-less "build → open Revit → test" works
    without a manual copy step. Comment this out if you'd rather manage
    installs by hand (see README).
  -->
  <!--
    Signs the DLL with a local code-signing certificate (subject
    "CN=PrasKaa", auto-created on first Release build) so Revit's
    security dialog shows Publisher/Issuer: PrasKaa instead of
    "Unknown Publisher"/"None". The cert is self-signed, so Revit still
    asks once per new build hash — click "Always Load"; trusting the
    cert in Cert:\CurrentUser\Root removes the prompt entirely.
    Runs after Build and before DeployAddin so the deployed DLL is the
    signed one.
  -->
  <Target Name="AuthenticodeSign" BeforeTargets="DeployAddin">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$c = Get-ChildItem Cert:\CurrentUser\My | Where-Object { $_.Subject -eq 'CN=PrasKaa' -and $_.HasPrivateKey } | Select-Object -First 1; if (-not $c) { $c = New-SelfSignedCertificate -Type CodeSigningCert -Subject 'CN=PrasKaa' -CertStoreLocation 'Cert:\CurrentUser\My' -NotAfter (Get-Date).AddYears(20) }; Set-AuthenticodeSignature -FilePath '$(TargetPath)' -Certificate $c | Out-Null&quot;" />
  </Target>

  <Target Name="DeployAddin" AfterTargets="Build">
    <ItemGroup>
      <AddinFiles Include="$(ProjectDir)UltimateJoinElements.addin" />
      <BuiltDlls Include="$(TargetDir)UltimateJoinElements.dll" />
    </ItemGroup>
    <!--
      Revit 2026 does not appear to resolve a bare-filename <Assembly>
      (e.g. "MyAddin.dll") in a user .addin manifest. Every add-in that
      loads uses an absolute path or a relative path with a subfolder,
      so the DLL goes into its own subfolder and the manifest references
      "UltimateJoinElements\UltimateJoinElements.dll".
    -->
    <MakeDir Directories="$(AppData)\Autodesk\Revit\Addins\2026" />
    <MakeDir Directories="$(AppData)\Autodesk\Revit\Addins\2026\UltimateJoinElements" />
    <Copy SourceFiles="@(AddinFiles)" DestinationFolder="$(AppData)\Autodesk\Revit\Addins\2026" />
    <Copy SourceFiles="@(BuiltDlls)" DestinationFolder="$(AppData)\Autodesk\Revit\Addins\2026\UltimateJoinElements" />
    <!-- Remove the old flat-layout DLL so only one copy is ever loaded. -->
    <Delete Files="$(AppData)\Autodesk\Revit\Addins\2026\UltimateJoinElements.dll" ContinueOnError="true" />
  </Target>

</Project>
