{
  "$schema": "https://app.kilo.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "bash": {
      "dotnet build*": "allow",
      "dotnet run*": "allow",
      "dotnet --list-sdks*": "allow",
      "dotnet --list-runtimes*": "allow",
      "tasklist*": "allow",
      "cmd /c dir*": "allow",
      "reg query*": "allow",
      "reg delete*": "ask",
      "reg add*": "ask",
      "taskkill*": "ask",
      "*": "ask"
    },
    "external_directory": "allow"
  }
}
